# AI CareerPilot Environment Configuration
# Copy this file to .env and provide your actual API key

# Gemini API Key (get yours from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model selection (e.g. gemini-2.5-flash, gemini-1.5-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Flask Application Settings
FLASK_DEBUG=False
SECRET_KEY=replace-with-a-random-secure-secret-key
PORT=5000
HOST=127.0.0.1

# Upload Constraints
MAX_CONTENT_LENGTH=5242880
TIMEOUT_SECONDS=45
MAX_RETRIES=2
